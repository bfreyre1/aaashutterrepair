# Public site URL used for canonicals, sitemap, and robots.
# Keep https. Do not use hash URLs as landers.
NEXT_PUBLIC_SITE_URL=https://www.aaashutterrepair.com

# Google Ads gtag. Defaults to AW-11547263826 if unset.
NEXT_PUBLIC_AW_ID=AW-11547263826

# Optional conversion labels from Google Ads (the suffix after AW-xxxxx/).
# Leave empty until you create the conversion actions.
NEXT_PUBLIC_AW_PHONE_LABEL=
NEXT_PUBLIC_AW_LEAD_LABEL=

# GA4 — do not invent a G- ID. Uncomment and set only when you have a real property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
