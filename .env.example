# Public site URL used for canonicals, sitemap, and robots.
# Keep https. Do not use hash URLs as landers.
NEXT_PUBLIC_SITE_URL=https://www.aaashutterrepair.com

# Existing Google Ads remarketing / config tag. Do not remove.
# Defaults to AW-11547263826 if unset.
NEXT_PUBLIC_AW_ID=AW-11547263826

# Quote form conversion ("Quote form submit"). Prefer this send_to.
NEXT_PUBLIC_AW_LEAD_SEND_TO=AW-16874362178/mjU2CM-2qu8cEMKqqe4-
# Optional split form of the same conversion (used if SEND_TO is unset).
# NEXT_PUBLIC_AW_LEAD_ID=AW-16874362178
# NEXT_PUBLIC_AW_LEAD_LABEL=mjU2CM-2qu8cEMKqqe4-

# Optional phone conversion label (the suffix after AW-xxxxx/).
# Leave empty until you create that conversion action.
NEXT_PUBLIC_AW_PHONE_LABEL=

# Optional text / SMS click conversion label. Leave empty until Ads
# provides one. sms: clicks still fire a text_click event in gtag.
NEXT_PUBLIC_AW_TEXT_LABEL=

# GA4 web stream on the AAA Shutter Repair property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z405VVNDE8

# Same token as the Tailor Brands / GoDaddy TXT record.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=BXqZURwP605mm2TKu4z7y5BMi8rVgYvKq5RB9cJywV8
# HTML-tag token for the info@ Search Console URL-prefix property.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION_INFO=tBt86v_ONfyMJKCFZ1kPPC5UVPk99LSHJOI34NZAPPs

# Server-only Kickserv API token for /api/quote (Basic auth: user=token, pass=token).
# Never prefix with NEXT_PUBLIC_. Required in Vercel Production / Preview.
KICKSERV_API_TOKEN=

# Optional Kickserv account slug. Defaults to c56cad (AAA Shutter Repair).
# KICKSERV_ACCOUNT=c56cad
